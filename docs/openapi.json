{
  "openapi": "3.0.0",
  "paths": {
    "/opportunities": {
      "get": {
        "description": "Retorna una página de oportunidades (OpportunitySummary). Soporta búsqueda híbrida semántica y por texto completo cuando se provee el parámetro `q` (ordenado por relevancia por defecto), o consulta filtrada directa sobre PostgreSQL con paginación real `COUNT(*) OVER()`.",
        "operationId": "OpportunityController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Página de oportunidades que cumplen los criterios de búsqueda y filtrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpportunitySummaryPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de consulta o paginación inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Listado paginado de oportunidades con búsqueda y filtros",
        "tags": [
          "Opportunities"
        ]
      }
    },
    "/opportunities/{id}": {
      "get": {
        "description": "Retorna el detalle de una oportunidad de contratación. Si aún no cuenta con resumen analítico, encola el trabajo de generación bajo demanda y responde con summaryStatus = \"pending\".",
        "operationId": "OpportunityController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador único de la oportunidad",
            "schema": {
              "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la oportunidad con estado de resumen (pending | ready | fallback | unavailable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpportunityDetail"
                }
              }
            }
          },
          "404": {
            "description": "La oportunidad solicitada no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Obtener detalle de una oportunidad por ID",
        "tags": [
          "Opportunities"
        ]
      }
    },
    "/opportunities/sync": {
      "post": {
        "description": "Consulta la API pública de SECOP II (Socrata), normaliza los procesos hacia el modelo de dominio Opportunity, detecta cambios o nuevas convocatorias y encola los trabajos de indexación asíncrona.",
        "operationId": "OpportunityController_sync",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncOpportunitiesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Procesos sincronizados e indexados en cola correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOpportunitiesResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de sincronización inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "502": {
            "description": "Error de conectividad o respuesta inválida del endpoint de SECOP II",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Sincronizar oportunidades desde SECOP II",
        "tags": [
          "Opportunities"
        ]
      }
    },
    "/profiles": {
      "post": {
        "description": "Registra las capacidades técnicas, sector y preferencias de contratación de una empresa u oferente, utilizadas por el motor de priorización para generar recomendaciones explicadas.",
        "operationId": "ProfileController_configure",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil guardado exitosamente en el repositorio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros o invariantes de perfil inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Configurar o actualizar perfil de contratista",
        "tags": [
          "Profiles"
        ]
      }
    },
    "/recommendations/{profileId}": {
      "get": {
        "description": "Retorna las recomendaciones precalculadas para el perfil indicado ordenadas descendentemente por score con sus factores explicados.",
        "operationId": "RecommendationController_getRecommendations",
        "parameters": [
          {
            "name": "profileId",
            "required": true,
            "in": "path",
            "description": "Identificador único del perfil de contratista",
            "schema": {
              "example": "d9b2d63d-a232-4d2c-8cb4-e5e6b72a44f1",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de recomendaciones ordenadas descendentemente por score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecommendationDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "El perfil solicitado no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Obtener recomendaciones priorizadas para un perfil",
        "tags": [
          "Recommendations"
        ]
      }
    },
    "/recommendations/{id}/feedback": {
      "post": {
        "description": "Guarda la decisión del usuario (Participate o Discard) respecto a una recomendación específica para alimentar el ciclo de aprendizaje de la plataforma.",
        "operationId": "RecommendationController_registerFeedback",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Identificador único de la recomendación",
            "schema": {
              "example": "rec-123e4567-e89b-12d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterFeedbackDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decisión de feedback guardada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterFeedbackResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Decisión inválida (debe ser Participate o Discard)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          },
          "404": {
            "description": "La recomendación no fue encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Registrar feedback sobre una recomendación",
        "tags": [
          "Recommendations"
        ]
      }
    },
    "/alerts/review-follow-up": {
      "post": {
        "description": "Recorre todas las alertas no entregadas en la base de datos (adendas, cambios de estado o plazos críticos), envía las notificaciones por correo electrónico a través de NotificationPort y las marca como entregadas.",
        "operationId": "AlertController_reviewFollowUp",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Revisión y envío de alertas completado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewFollowUpResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Error interno al procesar alertas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeDto"
                }
              }
            }
          }
        },
        "summary": "Ejecutar revisión de seguimiento de alertas",
        "tags": [
          "Alerts"
        ]
      }
    }
  },
  "info": {
    "title": "Pliegos API",
    "description": "Pliegos — Inteligencia de contratación pública. Descubre, analiza, prioriza con explicaciones y monitorea oportunidades de contratación estatal en Colombia (SECOP).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Opportunities",
      "description": "Ingesta desde SECOP II, normalización y búsqueda híbrida"
    },
    {
      "name": "Profiles",
      "description": "Perfiles de contratistas, capacidades y preferencias"
    },
    {
      "name": "Recommendations",
      "description": "Motor de priorización con explicaciones y registro de feedback"
    },
    {
      "name": "Alerts",
      "description": "Monitoreo de adendas, fechas límite y notificaciones"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "ContractingEntityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ministerio de Tecnologías de la Información y las Comunicaciones"
          },
          "taxId": {
            "type": "string",
            "example": "899999053-1"
          }
        },
        "required": [
          "name",
          "taxId"
        ]
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá"
          },
          "department": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá D.C."
          }
        },
        "required": [
          "city",
          "department"
        ]
      },
      "SourceReferenceDto": {
        "type": "object",
        "properties": {
          "sourceName": {
            "type": "string",
            "enum": [
              "SECOP"
            ],
            "example": "SECOP"
          },
          "externalId": {
            "type": "string",
            "example": "CO1.REQ.2577563"
          },
          "humanReference": {
            "type": "string",
            "example": "MINTIC-LP-012-2026"
          },
          "originalUrl": {
            "type": "string",
            "example": "https://community.secop.gov.co/Public/Tendering/OpportunityDetail/Index?noticeUID=CO1.NTC.1"
          }
        },
        "required": [
          "sourceName",
          "externalId",
          "humanReference",
          "originalUrl"
        ]
      },
      "OpportunitySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
          },
          "title": {
            "type": "string",
            "example": "Servicio de desarrollo de software a la medida"
          },
          "description": {
            "type": "string",
            "example": "Desarrollo e implementación de plataforma web en arquitectura hexagonal"
          },
          "contractingEntity": {
            "$ref": "#/components/schemas/ContractingEntityDto"
          },
          "entityName": {
            "type": "string",
            "example": "Ministerio de Tecnologías de la Información y las Comunicaciones"
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "city": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá"
          },
          "department": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá D.C."
          },
          "amount": {
            "type": "number",
            "nullable": true,
            "description": "Amount in COP, or null when the opportunity does not declare a known amount",
            "example": 150000000
          },
          "amountKnown": {
            "type": "boolean",
            "example": true
          },
          "currency": {
            "type": "string",
            "example": "COP"
          },
          "contractType": {
            "type": "string",
            "example": "Prestación de servicios"
          },
          "procurementModality": {
            "type": "string",
            "example": "Licitación pública"
          },
          "isCompetitive": {
            "type": "boolean",
            "example": true
          },
          "categoryCode": {
            "type": "string",
            "nullable": true,
            "example": "80111600"
          },
          "publishedAt": {
            "type": "string",
            "example": "2026-10-01T08:00:00.000Z"
          },
          "lastPublishedAt": {
            "type": "string",
            "example": "2026-10-10T12:00:00.000Z"
          },
          "closingDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-30T17:00:00.000Z"
          },
          "daysToClose": {
            "type": "number",
            "nullable": true,
            "description": "Whole days remaining until closingDate, or null when closingDate is null",
            "example": 12
          },
          "isOpenForSubmission": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Published",
              "Amended",
              "Closed",
              "Awarded",
              "Cancelled",
              "Unknown"
            ],
            "example": "Published"
          },
          "source": {
            "$ref": "#/components/schemas/SourceReferenceDto"
          },
          "sourceUrl": {
            "type": "string",
            "example": "https://community.secop.gov.co/Public/Tendering/OpportunityDetail/Index?noticeUID=CO1.NTC.1"
          },
          "summaryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "fallback",
              "unavailable"
            ],
            "example": "ready"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "contractingEntity",
          "entityName",
          "location",
          "city",
          "department",
          "amount",
          "amountKnown",
          "currency",
          "contractType",
          "procurementModality",
          "isCompetitive",
          "categoryCode",
          "publishedAt",
          "lastPublishedAt",
          "closingDate",
          "daysToClose",
          "isOpenForSubmission",
          "status",
          "source",
          "sourceUrl",
          "summaryStatus"
        ]
      },
      "OpportunitySummaryPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpportunitySummary"
            }
          },
          "total": {
            "type": "number",
            "example": 42
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "pageSize": {
            "type": "number",
            "example": 20
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "ErrorEnvelopeDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "ValidationError"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "object",
            "description": "Optional structured details about the error",
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "example": "c42d8e41-29a4-4f6a-9870-8d65e32b5011"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "requestId"
        ]
      },
      "RequirementDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "Experiencia específica en desarrollo web"
          },
          "type": {
            "type": "string",
            "enum": [
              "technical",
              "financial",
              "legal"
            ],
            "example": "technical"
          }
        },
        "required": [
          "text",
          "type"
        ]
      },
      "AnalysisDto": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "nullable": true,
            "example": "Resumen analítico conciso del proceso."
          },
          "summaryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "fallback",
              "unavailable"
            ],
            "example": "ready"
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequirementDto"
            }
          },
          "embeddingGeneratedAt": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-10T12:05:00.000Z"
          }
        },
        "required": [
          "summary",
          "summaryStatus",
          "requirements",
          "embeddingGeneratedAt"
        ]
      },
      "ChangeDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "closingDate"
          },
          "previousValue": {
            "type": "string",
            "example": "2026-10-25T17:00:00.000Z"
          },
          "newValue": {
            "type": "string",
            "example": "2026-10-30T17:00:00.000Z"
          },
          "detectedAt": {
            "type": "string",
            "example": "2026-10-15T09:00:00.000Z"
          },
          "material": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "field",
          "previousValue",
          "newValue",
          "detectedAt",
          "material"
        ]
      },
      "OpportunityDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
          },
          "title": {
            "type": "string",
            "example": "Servicio de desarrollo de software a la medida"
          },
          "description": {
            "type": "string",
            "example": "Desarrollo e implementación de plataforma web en arquitectura hexagonal"
          },
          "contractingEntity": {
            "$ref": "#/components/schemas/ContractingEntityDto"
          },
          "entityName": {
            "type": "string",
            "example": "Ministerio de Tecnologías de la Información y las Comunicaciones"
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "city": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá"
          },
          "department": {
            "type": "string",
            "nullable": true,
            "example": "Bogotá D.C."
          },
          "amount": {
            "type": "number",
            "nullable": true,
            "description": "Amount in COP, or null when the opportunity does not declare a known amount",
            "example": 150000000
          },
          "amountKnown": {
            "type": "boolean",
            "example": true
          },
          "currency": {
            "type": "string",
            "example": "COP"
          },
          "contractType": {
            "type": "string",
            "example": "Prestación de servicios"
          },
          "procurementModality": {
            "type": "string",
            "example": "Licitación pública"
          },
          "isCompetitive": {
            "type": "boolean",
            "example": true
          },
          "categoryCode": {
            "type": "string",
            "nullable": true,
            "example": "80111600"
          },
          "publishedAt": {
            "type": "string",
            "example": "2026-10-01T08:00:00.000Z"
          },
          "lastPublishedAt": {
            "type": "string",
            "example": "2026-10-10T12:00:00.000Z"
          },
          "closingDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-30T17:00:00.000Z"
          },
          "daysToClose": {
            "type": "number",
            "nullable": true,
            "description": "Whole days remaining until closingDate, or null when closingDate is null",
            "example": 12
          },
          "isOpenForSubmission": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Published",
              "Amended",
              "Closed",
              "Awarded",
              "Cancelled",
              "Unknown"
            ],
            "example": "Published"
          },
          "source": {
            "$ref": "#/components/schemas/SourceReferenceDto"
          },
          "sourceUrl": {
            "type": "string",
            "example": "https://community.secop.gov.co/Public/Tendering/OpportunityDetail/Index?noticeUID=CO1.NTC.1"
          },
          "summaryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "fallback",
              "unavailable"
            ],
            "example": "ready"
          },
          "summary": {
            "type": "string",
            "nullable": true,
            "example": "Resumen analítico conciso del proceso."
          },
          "analysis": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AnalysisDto"
              }
            ]
          },
          "changeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "contractingEntity",
          "entityName",
          "location",
          "city",
          "department",
          "amount",
          "amountKnown",
          "currency",
          "contractType",
          "procurementModality",
          "isCompetitive",
          "categoryCode",
          "publishedAt",
          "lastPublishedAt",
          "closingDate",
          "daysToClose",
          "isOpenForSubmission",
          "status",
          "source",
          "sourceUrl",
          "summaryStatus",
          "summary",
          "analysis",
          "changeHistory"
        ]
      },
      "SyncOpportunitiesDto": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "Fecha ISO 8601 a partir de la cual sincronizar procesos modificados o nuevos",
            "example": "2026-01-01T00:00:00Z"
          },
          "maxRecords": {
            "type": "number",
            "description": "Máximo de procesos a traer (paginado de a 1000). Por defecto SECOP_SYNC_MAX_RECORDS o 5000.",
            "example": 5000
          }
        }
      },
      "SyncOpportunitiesResponseDto": {
        "type": "object",
        "properties": {
          "created": {
            "type": "number",
            "example": 12
