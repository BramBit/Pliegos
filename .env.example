# ==============================================================================
# Pliegos - Public Procurement Intelligence Platform
# Environment Configuration Template (.env.example)
# Every variable is validated at startup (src/config/env.ts). Invalid or
# missing required values make the process exit with code 1.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Runtime mode: development | test | production (default: development)
NODE_ENV=development
# Process role: api | worker | all (default: all)
ROLE=all
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
# HTTP port of the API (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database
# ------------------------------------------------------------------------------
# Primary application connection string (required, no fallback)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pliegos

# Dedicated test database connection string (optional; required by the
# integration and e2e test suites, which never fall back to another database)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pliegos_test

# ------------------------------------------------------------------------------
# Redis & BullMQ Job Queue
# ------------------------------------------------------------------------------
# Redis host used by BullMQ (required)
REDIS_HOST=localhost
# Redis port used by BullMQ (required)
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Ollama Local AI Provider
# ------------------------------------------------------------------------------
# Base URL of the local Ollama server (required)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding model; output must be 768 dimensions (required)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Chat model used for summarization (required)
OLLAMA_CHAT_MODEL=llama3.1
# Timeout in milliseconds for Ollama embedding requests (default: 30000)
OLLAMA_EMBED_TIMEOUT_MS=30000
# Timeout in milliseconds for Ollama chat/summarization requests (default: 120000)
OLLAMA_CHAT_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# Scheduler Driving Adapter (Cron Intervals)
# ------------------------------------------------------------------------------
# SyncOpportunitiesUseCase: Every 4 hours (required)
SYNC_OPPORTUNITIES_CRON=0 0-23/4 * * *

# ReviewFollowUpUseCase: Daily at 8:00 AM (required)
REVIEW_FOLLOW_UP_CRON=0 08 * * *

# ScanDeadlinesUseCase: Daily at 7:30 AM (default: 30 07 * * *)
SCAN_DEADLINES_CRON=30 07 * * *

# ------------------------------------------------------------------------------
# SECOP Data Source
# ------------------------------------------------------------------------------
# Optional Socrata app token to raise datos.gov.co rate limits (leave empty if unused)
SECOP_APP_TOKEN=
# Records requested per SECOP page (default: 1000)
SECOP_PAGE_SIZE=1000
# Maximum records processed per sync run (default: 5000)
SECOP_SYNC_MAX_RECORDS=5000
# Initial lookback window in days when no sync watermark exists (default: 14)
SECOP_SYNC_WINDOW_DAYS=14

# ------------------------------------------------------------------------------
# Opportunity Analysis Job
# ------------------------------------------------------------------------------
# Parallel analysis jobs processed by BullMQ (default: 2)
ANALYSIS_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Recommendation Scoring Thresholds
# ------------------------------------------------------------------------------
# Lower cosine bound for semantic similarity normalization (default: 0.40)
SEMANTIC_COSINE_LOW=0.40
# Upper cosine bound for semantic similarity normalization (default: 0.75)
SEMANTIC_COSINE_HIGH=0.75
# Minimum combined score required to persist and return a recommendation (default: 0.45)
MIN_RECOMMENDATION_SCORE=0.45

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used to sign access and refresh JWTs (minimum 32 characters, required)
JWT_SECRET=development-jwt-secret-key-must-be-at-least-32-characters-long
# Access token expiration (default: 15m)
JWT_ACCESS_TTL=15m
# Refresh token expiration (default: 7d)
JWT_REFRESH_TTL=7d

# ------------------------------------------------------------------------------
# User Resource Limits
# ------------------------------------------------------------------------------
# Maximum contractor profiles allowed per user (default: 5)
MAX_PROFILES_PER_USER=5

# ------------------------------------------------------------------------------
# Alert Notification Settings
# ------------------------------------------------------------------------------
# Also alert on top 5 new recommendations closing within 3 days (default: false)
RECOMMEND_DEADLINE_ALERTS=false

# ------------------------------------------------------------------------------
# Security & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty in production means no cross-origin access.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# SMTP / Email Delivery
# ------------------------------------------------------------------------------
# Host of the SMTP server (default: localhost; points to Mailpit in development)
SMTP_HOST=localhost
# Port of the SMTP server (default: 1025 for Mailpit, 587 for TLS)
SMTP_PORT=1025
# SMTP authentication username (empty if no auth)
SMTP_USER=
# SMTP authentication password (empty if no auth)
SMTP_PASS=
# Default From header
SMTP_FROM=Pliegos <alertas@pliegos.co>
# Use TLS/SSL connection directly (default: false)
SMTP_SECURE=false

