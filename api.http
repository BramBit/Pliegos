### ==============================================================================
### Pliegos — API REST Client Collection (Phase 1 MVP)
### File: api.http (VS Code REST Client extension)
### Description: Comprehensive manual testing and verification suite for every
###              endpoint in Pliegos, including realistic Colombian SECOP II
###              payloads, structured & semantic search, contractor profiles,
###              explainable recommendations, feedback, and alerts.
###
### Execution Order:
###   1. Docs: GET /reference and GET /api-json
###   2. Sync: POST /opportunities/sync
###   3. Opportunities: GET /opportunities (paginated list, hybrid & structured filters) and GET /opportunities/:id (detail with lazy summary)
###   4. Profiles: POST /profiles (configureProfileTech, configureProfileCivilInfra)
###   5. Recommendations Feed: GET /profiles/:id/recommendations (filtered by state, minScore, paginated)
###   6. Recommendation Feedback & Undo: POST/DELETE /recommendations/:id/feedback
###   7. Watchlist & Profile Summary: POST/DELETE /profiles/:id/watches/:opportunityId, GET /profiles/:id/watches, GET /profiles/:id/summary
###   8. Alerts: POST /alerts/review-follow-up
###   9. Negative cases: invalid body (400), unknown profileId (404), invalid feedback (400)
### ==============================================================================

### Variables for request chaining
@baseUrl = http://localhost:3000
@profileId = d9b2d63d-a232-4d2c-8cb4-e5e6b72a44f1
@opportunityId = 9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d
@recommendationId = 3bfc62c2-5918-426b-a908-660eb2e5a662

### ==============================================================================
### 1. API Documentation & OpenAPI Specification
### ==============================================================================

# Validates OpenAPI 3.0 specification generation from NestJS decorators
# @name getOpenApiSpec
GET {{baseUrl}}/api-json
Accept: application/json

###

# Validates Scalar interactive documentation UI mounted on the server
# @name getScalarDocs
GET {{baseUrl}}/reference
Accept: text/html

### ==============================================================================
### 2. Opportunities Ingestion (SECOP II Sync)
### ==============================================================================

# Validates ingestion of procurement processes from SECOP II / Socrata API,
# verifying the ISO 8601 date filter, normalizing tenders to Opportunity entities,
# persisting them in PostgreSQL, and enqueuing async AI analysis jobs in BullMQ.
# @name syncOpportunitiesWithDate
POST {{baseUrl}}/opportunities/sync
Content-Type: application/json

{
  "since": "2026-01-01T00:00:00.000Z"
}

###

# Validates full synchronization without a date boundary (syncs latest available tenders)
# @name syncOpportunitiesFull
POST {{baseUrl}}/opportunities/sync
Content-Type: application/json

{}

### ==============================================================================
### 3. Opportunities List & Detail (Paginated, Hybrid & Structured)
### ==============================================================================

# Validates hybrid search combining natural language semantic query with structured
# filters (UNSPSC prefix, department, and budget range) using pgvector and RRF.
# @name listOpportunitiesHybrid
GET {{baseUrl}}/opportunities?q=Desarrollo+de+software+a+la+medida&categoryPrefix=V1.8011&department=Cundinamarca&minAmount=50000000&maxAmount=500000000&pageSize=10
Accept: application/json

###

# Validates free-text semantic query with relevance sort and custom pagination
# @name listOpportunitiesSemantic
GET {{baseUrl}}/opportunities?q=Mantenimiento+preventivo+y+correctivo&pageSize=5&sort=relevance&order=desc
Accept: application/json

###

# Validates relational filtered query with COUNT(*) OVER() pagination and sort by published date
# @name listOpportunitiesStructuredOnly
GET {{baseUrl}}/opportunities?categoryPrefix=V1.8111&department=Antioquia&minAmount=20000000&maxAmount=300000000&page=1&pageSize=10&sort=publishedAt&order=desc
Accept: application/json

###

# Validates opportunity detail retrieval with lazy LLM summary enqueuing
# @name getOpportunityDetail
GET {{baseUrl}}/opportunities/{{opportunityId}}
Accept: application/json

### ==============================================================================
### 4. Contractor Profiles Management (CRUD)
### ==============================================================================

# Validates contractor profile creation with an explicit UUID (@profileId),
# registering name, contactEmail, alertsEnabled, deadlineAlertDays, IT/Software capabilities,
# budget bounds, and UNSPSC category preferences for subsequent recommendation matching.
# @name configureProfileTech
POST {{baseUrl}}/profiles
Content-Type: application/json

{
  "profileId": "{{profileId}}",
  "ownerId": "usr-tech-innovations-01",
  "name": "Tech Innovations SAS",
  "contactEmail": "licitaciones@techinnovations.com",
  "alertsEnabled": true,
  "deadlineAlertDays": 3,
  "sector": "Tecnologías de la Información y Desarrollo de Software",
  "capabilities": [
    {
      "name": "Desarrollo de Software Fullstack y Arquitectura Cloud",
      "yearsOfExperience": 7
    },
    {
      "name": "Inteligencia Artificial y Modelos de Lenguaje",
      "yearsOfExperience": 3
    },
    {
      "name": "Ciberseguridad y Auditoría de Sistemas",
      "yearsOfExperience": 5
    }
  ],
  "preferences": {
    "categoryCodes": [
      "V1.81111500",
      "V1.80111600",
      "V1.43230000"
    ],
    "keywords": [
      "software",
      "inteligencia artificial",
      "cloud",
      "interoperabilidad",
      "datos"
    ],
    "amountRange": {
      "min": 50000000,
      "max": 500000000
    },
    "departments": [
      "Bogotá D.C.",
      "Cundinamarca",
      "Antioquia"
    ]
  }
}

