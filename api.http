### ==============================================================================
### 6. Recommendation Feed (Filtered, Paginated, Single SQL Join)
### ==============================================================================

# Validates retrieving paginated recommendation feed for a contractor profile,
# filtering by feedback state ('new', 'participate', 'discard', 'all'), optional minScore,
# and returning opportunity summaries with match explanations and run metadata in a single query.
# @name getRecommendationsFeedNew
GET {{baseUrl}}/profiles/{{profileId}}/recommendations?state=new&pageSize=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates retrieving all recommendations for the profile with minScore threshold
# @name getRecommendationsFeedAll
GET {{baseUrl}}/profiles/{{profileId}}/recommendations?state=all&minScore=0.7&page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### ==============================================================================
### 7. Recommendation Feedback & Undo (Atomic Watch Synchronization)
### ==============================================================================

# Validates recording user decision ('Participate') on a specific recommendation,
# which updates recommendation feedback and atomically adds the opportunity to watchlist.
# @name registerFeedbackParticipate
POST {{baseUrl}}/recommendations/{{recommendationId}}/feedback
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "decision": "Participate"
}

###

# Validates undoing recommendation feedback (DELETE), resetting feedback to null
# and removing the opportunity from watchlist if previously marked Participate.
# @name undoFeedback
DELETE {{baseUrl}}/recommendations/{{recommendationId}}/feedback
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates recording a rejection decision ('Discard'), which removes the opportunity
# from watchlist if present and records the discard decision.
# @name registerFeedbackDiscard
POST {{baseUrl}}/recommendations/{{recommendationId}}/feedback
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "decision": "Discard"
}

### ==============================================================================
### 8. Watchlist & Profile Summary
### ==============================================================================

# Validates manually adding an opportunity to the contractor profile's watchlist
# @name addOpportunityToWatchlist
POST {{baseUrl}}/profiles/{{profileId}}/watches/{{opportunityId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates retrieving paginated watchlist with opportunity details and last 10 changes
# @name getWatchedOpportunities
GET {{baseUrl}}/profiles/{{profileId}}/watches?page=1&pageSize=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates profile summary metrics for UI dashboards (new recommendations, watching,
# closing soon within 7 days, unread alerts)
# @name getProfileSummary
GET {{baseUrl}}/profiles/{{profileId}}/summary
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates removing an opportunity from the contractor profile's watchlist
# @name removeOpportunityFromWatchlist
DELETE {{baseUrl}}/profiles/{{profileId}}/watches/{{opportunityId}}
Authorization: Bearer {{accessToken}}
Accept: application/json


### ==============================================================================
### 10. Negative Test Cases & Security Errors (Expect 400 / 401 / 404)
### ==============================================================================

# Validates global AuthGuard: unauthenticated request to protected endpoint (Expect HTTP 401 Unauthorized)
# @name negativeUnauthenticatedRequest
GET {{baseUrl}}/opportunities
Accept: application/json

###

# Validates input validation error handling (Expect HTTP 400 Bad Request):
# minAmount cannot exceed maxAmount in budget preferences.
# @name negativeProfileInvalidAmountRange
POST {{baseUrl}}/profiles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "ownerId": "usr-test-invalid",
  "sector": "Servicios de Software",
  "capabilities": [],
  "preferences": {
    "categoryCodes": ["V1.81111500"],
    "keywords": ["software"],
    "amountRange": {
      "min": 500000000,
      "max": 100000000
    },
    "departments": []
  }
}

###

# Validates non-existent profile error handling (Expect HTTP 404 Not Found):
# Looking up recommendation feed for a non-registered profile ID.
# @name negativeRecommendationsUnknownProfile
GET {{baseUrl}}/profiles/00000000-0000-0000-0000-000000000000/recommendations
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Validates feedback domain enum validation (Expect HTTP 400 Bad Request):
# Decision must strictly be 'Participate' or 'Discard'.
# @name negativeFeedbackInvalidDecision
POST {{baseUrl}}/recommendations/{{recommendationId}}/feedback
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "decision": "MaybeLater"
}
