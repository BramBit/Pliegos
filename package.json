{
  "name": "pliegos",
  "version": "1.0.0",
  "description": "Pliegos - Public procurement intelligence platform",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc",
    "start": "tsc && node dist/src/main.js",
    "start:dev": "tsc && node --watch dist/src/main.js",
    "db:migrate": "tsc && node dist/scripts/migrate.js",
    "db:init": "pnpm db:migrate",
    "audit:data": "tsc && node dist/scripts/audit-data.js",
    "test": "CI=true NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "CI=true NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "check:ollama": "node dist/scripts/manual-check-ollama-search.js",
    "e2e": "node dist/scripts/run-full-flow-e2e.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@scalar/nestjs-api-reference": "^1.2.25",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 1,
    "verbose": true
  }
}
